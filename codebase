#!/usr/bin/env python3
"""codebase - bir proje klasöründeki geliştirici dosyalarının satır/karakter istatistiği.

Kullanım:
    codebase                 # bulunduğun klasörün özeti
    codebase ~/proje         # başka bir klasör
    codebase -d              # dosya bazlı detaylı liste de göster
    codebase -d -s lines     # detaylı listeyi satır sayısına göre sırala
    codebase -x tests        # klasör/dosya deseni hariç tut
    codebase --no-git        # git'i yok say, klasörü doğrudan gez
    codebase --only .cpp,.h  # sadece bu uzantılar
    codebase -e .zig:Zig://  # bu seferlik ek uzantı say
    codebase --skip .html    # bu seferlik uzantı sayma
    codebase --add .zig:Zig://   # uzantıyı kalıcı ekle
    codebase --remove .html      # uzantıyı kalıcı çıkar
    codebase --list          # tanınan uzantılar ve kalıcı ayarlar

Kalıcı ayarlar ~/.config/codebase/extensions dosyasında tutulur, elle de
düzenlenebilir: ekleme için  .zig:Zig://  çıkarma için  -.html

Git deposu içindeyse sadece git'in takip ettiği + .gitignore'a takılmayan
dosyalar sayılır (build çıktıları vb. otomatik elenir). Değilse klasör
gezilir ve bilinen build/üretilmiş klasörler atlanır.
"""

import argparse
import fnmatch
import os
import subprocess
import sys
from collections import defaultdict

# Yorum stilleri: (satır yorumu önekleri, blok başlangıç, blok bitiş)
C_STYLE = (("//",), "/*", "*/")
HASH = (("#",), None, None)
STYLES = {
    "c": C_STYLE,
    "hash": HASH,
    "html": ((), "<!--", "-->"),
    "css": ((), "/*", "*/"),
    "sql": (("--",), "/*", "*/"),
    "lua": (("--",), "--[[", "]]"),
    "php": (("//", "#"), "/*", "*/"),
    "ps1": (("#",), "<#", "#>"),
    "bat": (("rem ", "@rem ", "::"), None, None),
    "none": ((), None, None),
}

# Varsayılan diller: dil adı -> (yorum stili, uzantılar)
DEFAULT_LANGS = {
    "C++ (.cpp)": ("c", ".cpp .cc .cxx .c++"),
    "Header (.h)": ("c", ".h .hpp .hh .hxx .inl"),
    "C (.c)": ("c", ".c"),
    "C#": ("c", ".cs"),
    "Java": ("c", ".java"),
    "Kotlin": ("c", ".kt .kts"),
    "Go": ("c", ".go"),
    "Rust": ("c", ".rs"),
    "Swift": ("c", ".swift"),
    "Dart": ("c", ".dart"),
    "QML": ("c", ".qml"),
    "JavaScript": ("c", ".js .jsx .mjs .cjs"),
    "TypeScript": ("c", ".ts .tsx"),
    "HTML": ("html", ".html .htm"),
    "Vue": ("html", ".vue"),
    "CSS": ("css", ".css"),
    "SCSS/Sass/Less": ("c", ".scss .sass .less"),
    "PHP": ("php", ".php"),
    "Python (.py/.pyw)": ("hash", ".py .pyw"),
    "Ruby": ("hash", ".rb"),
    "Perl": ("hash", ".pl .pm"),
    "R": ("hash", ".r"),
    "Shell (.sh)": ("hash", ".sh .bash .zsh"),
    "PowerShell": ("ps1", ".ps1 .psm1"),
    "Batch (.bat/.cmd)": ("bat", ".bat .cmd"),
    "Lua": ("lua", ".lua"),
    "SQL": ("sql", ".sql"),
    "CMake": ("hash", ".cmake"),
}
# Uzantısı olmayan ya da adıyla tanınan dosyalar
NAMED = {
    "CMakeLists.txt": ("CMake", "hash"),
    "Makefile": ("Makefile", "hash"),
    "Dockerfile": ("Dockerfile", "hash"),
}

DEFAULT_NAMED = set(NAMED)

# Kullanıcının kendi uzantıları bu dosyadan okunur (satır başına bir tane)
CONFIG_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "codebase", "extensions")

# git dışı modda atlanacak klasörler/desenler
DEFAULT_EXCLUDES = [
    ".*", "build", "build-*", "*-build", "cmake-build-*", "out", "dist",
    "node_modules", "__pycache__", "venv", "env", "*.egg-info", "debian",
    "third_party", "3rdparty", "vendor", "obj", "target",
]
# her iki modda atlanan, araçların ürettiği dosyalar
GENERATED = ["moc_*", "ui_*.h", "qrc_*", "*.pb.h", "*.pb.cc", "*_autogen*",
             "*.min.js", "*.min.css", "*.designer.cs"]

LANGS = {}  # uzantı -> (dil adı, yorum stili); main() içinde doldurulur


def build_langs():
    for name, (style, exts) in DEFAULT_LANGS.items():
        for ext in exts.split():
            LANGS[ext] = (name, STYLES[style])


def add_ext(spec, source):
    """'.ext', '.ext:Ad' veya '.ext:Ad:yorum' biçimindeki tanımı ekler.

    yorum: satır yorumu işareti (//, #, --, ;, % ...) ya da stil adı
    (c, hash, html, css, sql, lua, php, ps1, bat, none). '//' verilirse
    /* */ blokları da yorum sayılır.
    """
    parts = [x.strip() for x in spec.split(":", 2)]
    ext = parts[0].lower()
    if not ext:
        sys.exit(f"codebase: geçersiz uzantı tanımı ({source}): {spec}")
    if not ext.startswith("."):
        ext = "." + ext
    if len(parts) > 1 and parts[1]:
        name = parts[1]
    else:
        name = LANGS[ext][0] if ext in LANGS else ext[1:].upper()
    marker = parts[2] if len(parts) > 2 else ""
    if marker in STYLES:
        style = STYLES[marker]
    elif marker == "//":
        style = C_STYLE
    elif marker:
        style = ((marker,), None, None)
    elif ext in LANGS:
        style = LANGS[ext][1]
    else:
        style = STYLES["none"]
    LANGS[ext] = (name, style)


def remove_ext(spec):
    """'.ext' ya da 'Dockerfile' gibi bir tanımı sayımdan çıkarır."""
    spec = spec.strip()
    if spec in NAMED:
        del NAMED[spec]
        return
    ext = spec.lower()
    if not ext.startswith("."):
        ext = "." + ext
    LANGS.pop(ext, None)


def load_config():
    if not os.path.isfile(CONFIG_FILE):
        return
    with open(CONFIG_FILE, encoding="utf-8") as fh:
        for n, line in enumerate(fh, 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("-"):
                remove_ext(line[1:])
            else:
                add_ext(line, f"{CONFIG_FILE}:{n}")


def norm_key(spec):
    """Tanımın uzantı/dosya adı kısmını karşılaştırma için normalleştirir."""
    key = spec.strip().lstrip("-").split(":", 1)[0].strip()
    if key in NAMED or key in DEFAULT_NAMED:
        return key
    key = key.lower()
    return key if key.startswith(".") else "." + key


def save_config(add=(), remove=()):
    lines = []
    if os.path.isfile(CONFIG_FILE):
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            lines = [l.rstrip("\n") for l in fh]
    defaults = set(LANGS) | set(NAMED)  # load_config'den önce çağrılır
    changes = []
    for spec, removing in [(x, False) for x in add] + [(x, True) for x in remove]:
        key = norm_key(spec)
        lines = [l for l in lines
                 if not l.strip() or l.strip().startswith("#")
                 or norm_key(l) != key]
        if removing:
            if key in defaults:
                lines.append("-" + key)
            changes.append(f"çıkarıldı: {key}")
        elif key in defaults and ":" not in spec:
            changes.append(f"varsayılana döndü: {key}")  # sadece '-' satırı silinir
        else:
            add_ext(spec, "--add")  # biçimi doğrula
            lines.append(spec.strip())
            changes.append(f"eklendi  : {spec.strip()}")
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + ("\n" if lines else ""))
    for c in changes:
        print(c)
    print(f"Ayar dosyası: {CONFIG_FILE}")


def lang_of(name):
    if name in NAMED:
        lang, style = NAMED[name]
        return lang, STYLES[style]
    return LANGS.get(os.path.splitext(name)[1].lower())


def matches(path, patterns):
    parts = path.replace("\\", "/").split("/")
    return any(fnmatch.fnmatch(p, pat) for p in parts for pat in patterns)


def git_files(root):
    try:
        out = subprocess.run(
            ["git", "-C", root, "ls-files", "-z", "--cached", "--others",
             "--exclude-standard"],
            capture_output=True, check=True,
        ).stdout
    except (OSError, subprocess.CalledProcessError):
        return None
    files = [f for f in out.decode("utf-8", "replace").split("\0") if f]
    return [f for f in files if os.path.isfile(os.path.join(root, f))]


def walk_files(root, excludes):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames
                             if not any(fnmatch.fnmatch(d, p) for p in excludes))
        for f in filenames:
            yield os.path.relpath(os.path.join(dirpath, f), root)


def analyze(path, style):
    prefixes, block_s, block_e = style
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return None
    lines = text.splitlines()
    blank = comment = 0
    in_block = False
    for raw in lines:
        s = raw.strip()
        if not s:
            blank += 1
            continue
        if in_block:
            comment += 1
            if block_e in s:
                in_block = False
            continue
        if block_s and s.startswith(block_s):
            comment += 1
            if block_e not in s[len(block_s):]:
                in_block = True
            continue
        low = s.lower() + " "  # "rem" tek başına da eşleşsin
        if any(low.startswith(p.lower()) for p in prefixes):
            comment += 1
    total = len(lines)
    return {
        "lines": total, "code": total - blank - comment, "comment": comment,
        "blank": blank, "chars": len(text), "bytes": os.path.getsize(path),
    }


def fmt(n):
    return f"{n:,}".replace(",", ".")


def table(headers, rows, align):
    widths = [max(len(str(h)), *(len(str(r[i])) for r in rows)) if rows else len(h)
              for i, h in enumerate(headers)]

    def line(cells):
        return "  ".join(str(c).ljust(w) if a == "l" else str(c).rjust(w)
                         for c, w, a in zip(cells, widths, align))
    print(line(headers))
    print("  ".join("-" * w for w in widths))
    for r in rows:
        print(line(r))


def main():
    ap = argparse.ArgumentParser(description="Kod tabanı satır/karakter istatistiği")
    ap.add_argument("path", nargs="?", default=".", help="taranacak klasör (varsayılan: .)")
    ap.add_argument("-s", "--sort", choices=["path", "lines", "code", "chars"],
                    default="path", help="detaylı listenin sıralaması (-d ile)")
    ap.add_argument("-d", "--detailed", action="store_true",
                    help="özetin yanında dosya bazlı listeyi de göster")
    ap.add_argument("-x", "--exclude", action="append", default=[],
                    help="hariç tutulacak klasör/dosya deseni (tekrarlanabilir)")
    ap.add_argument("--no-git", action="store_true", help="git ls-files kullanma")
    ap.add_argument("-e", "--ext", action="append", default=[], metavar="TANIM",
                    help="ek uzantı say: .ext[:Ad[:yorum]], örn. -e .zig:Zig://")
    ap.add_argument("--only", metavar="UZANTILAR",
                    help="sadece bu uzantıları say, virgülle: --only .cpp,.h")
    ap.add_argument("--skip", metavar="UZANTILAR",
                    help="bu uzantıları sayma, virgülle: --skip .html,.css")
    ap.add_argument("--add", action="append", default=[], metavar="TANIM",
                    help="uzantıyı kalıcı ekle: --add .zig:Zig://")
    ap.add_argument("--remove", action="append", default=[], metavar="UZANTI",
                    help="uzantıyı kalıcı çıkar: --remove .html")
    ap.add_argument("--list", action="store_true", help="tanınan uzantıları listele")
    args = ap.parse_args()

    build_langs()
    if args.add or args.remove:
        rem = [x for r in args.remove for x in r.split(",") if x.strip()]
        save_config(args.add, rem)
        return
    load_config()
    for spec in args.ext:
        add_ext(spec, "-e")
    for spec in (args.skip or "").split(","):
        if spec.strip():
            remove_ext(spec)

    if args.list:
        by_lang = defaultdict(list)
        for ext, (lang, _) in LANGS.items():
            by_lang[lang].append(ext)
        for name, (lang, _) in NAMED.items():
            by_lang[lang].append(name)
        for lang in sorted(by_lang, key=str.lower):
            print(f"{lang:20} {' '.join(by_lang[lang])}")
        print(f"\nAyar dosyası: {CONFIG_FILE}")
        rules = []
        if os.path.isfile(CONFIG_FILE):
            with open(CONFIG_FILE, encoding="utf-8") as fh:
                rules = [l.strip() for l in fh
                         if l.strip() and not l.strip().startswith("#")]
        print("Kalıcı ayarlar: " + (", ".join(rules) if rules else "yok"))
        return

    only = None
    if args.only:
        only = {("" if e.strip().startswith(".") else ".") + e.strip().lower()
                for e in args.only.split(",") if e.strip()}

    root = os.path.abspath(os.path.expanduser(args.path))
    if not os.path.isdir(root):
        sys.exit(f"codebase: klasör yok: {root}")

    files = None if args.no_git else git_files(root)
    mode = "git (takip edilen + ignore edilmemiş dosyalar)"
    if files is None:
        files = list(walk_files(root, DEFAULT_EXCLUDES + args.exclude))
        mode = "klasör taraması (build/venv vb. hariç)"

    results = []
    for rel in files:
        name = os.path.basename(rel)
        found = lang_of(name)
        if not found or matches(rel, GENERATED + args.exclude):
            continue
        if only is not None and os.path.splitext(name)[1].lower() not in only:
            continue
        lang, style = found
        st = analyze(os.path.join(root, rel), style)
        if st:
            results.append((rel, lang, st))

    if not results:
        print(f"{root}: sayılacak kaynak dosyası bulunamadı.")
        return

    key = {"path": lambda r: r[0].lower(),
           "lines": lambda r: -r[2]["lines"],
           "code": lambda r: -r[2]["code"],
           "chars": lambda r: -r[2]["chars"]}[args.sort]
    results.sort(key=key)

    print(f"Proje : {root}")
    print(f"Mod   : {mode}\n")

    if args.detailed:
        table(["Dosya", "Dil", "Satır", "Kod", "Yorum", "Boş", "Karakter"],
              [(r, l, fmt(s["lines"]), fmt(s["code"]), fmt(s["comment"]),
                fmt(s["blank"]), fmt(s["chars"])) for r, l, s in results],
              "llrrrrr")
        print()

    agg = defaultdict(lambda: defaultdict(int))
    for _, lang, st in results:
        agg[lang]["files"] += 1
        for k, v in st.items():
            agg[lang][k] += v
    tot = defaultdict(int)
    for a in agg.values():
        for k, v in a.items():
            tot[k] += v

    rows = []
    for lang, a in sorted(agg.items(), key=lambda kv: -kv[1]["lines"]):
        pct = 100.0 * a["lines"] / tot["lines"] if tot["lines"] else 0
        rows.append((lang, fmt(a["files"]), fmt(a["lines"]), fmt(a["code"]),
                     fmt(a["comment"]), fmt(a["blank"]), fmt(a["chars"]),
                     f"{pct:5.1f}%"))
    rows.append(("TOPLAM", fmt(tot["files"]), fmt(tot["lines"]), fmt(tot["code"]),
                 fmt(tot["comment"]), fmt(tot["blank"]), fmt(tot["chars"]), "100.0%"))
    print("ÖZET (dile göre)")
    table(["Dil", "Dosya", "Satır", "Kod", "Yorum", "Boş", "Karakter", "Pay"],
          rows, "lrrrrrrr")

    biggest = max(results, key=lambda r: r[2]["lines"])
    print(f"\nEn büyük dosya : {biggest[0]} ({fmt(biggest[2]['lines'])} satır)")
    print(f"Ortalama       : {fmt(tot['lines'] // tot['files'])} satır/dosya")
    print(f"Toplam boyut   : {tot['bytes'] / 1024:.1f} KB")


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.stderr.close()
